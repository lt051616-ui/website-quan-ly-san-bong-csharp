@model Phân_Tích_Thiết_Kế_Website_QL_Sân_Bóng.Models.DichVu

@{
    ViewBag.Title = "Sửa Dịch Vụ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid" style="max-width: 600px; padding: 20px;">

    <h2 style="font-weight: bold; margin-bottom: 20px;">✏️ CẬP NHẬT THÔNG TIN DỊCH VỤ</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible">
            <button type="button" class="close" data-dismiss="alert">&times;</button>
            <strong>Lỗi!</strong> @TempData["Error"]
        </div>
    }

    <div class="panel panel-default">
        <div class="panel-heading" style="background: #ff9966; color: white; font-weight: bold;">
            Chỉnh sửa dịch vụ #@Model.MaDichVu
        </div>
        <div class="panel-body">
            <form method="post" action="@Url.Action("Sua", "DichVu", new { id = Model.MaDichVu })">
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.MaDichVu)

                <div class="form-group">
                    <label>Tên dịch vụ / Món:</label>
                    @Html.TextBoxFor(m => m.TenDichVu, new { @class = "form-control", required = "required" })
                </div>

                <div class="form-group">
                    <label>Đơn giá (VNĐ):</label>
                    @Html.TextBoxFor(m => m.DonGia, new { @class = "form-control", type = "number", required = "required", min = "0" })
                </div>

                <div class="form-group">
                    <label>Số lượng tồn hiện tại (Chỉ xem):</label>
                    <input type="text" class="form-control" value="@Model.SoLuongTon" readonly style="background-color: #f5f5f5;" />
                    <small class="text-muted">Để tăng/giảm số lượng tồn kho, vui lòng dùng chức năng "Nhập Kho" tại trang danh sách.</small>
                </div>

                <hr />

                <button type="submit" class="btn btn-success">
                    💾 Lưu thay đổi
                </button>
                <a href="@Url.Action("Index", "DichVu")" class="btn btn-default">
                    Quay lại
                </a>
            </form>
        </div>
    </div>

</div>