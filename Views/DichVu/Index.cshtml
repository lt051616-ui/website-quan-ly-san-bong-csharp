@model IEnumerable<Phân_Tích_Thiết_Kế_Website_QL_Sân_Bóng.Models.DichVu>

@{
    // =====================================================
    // PHÂN QUYỀN GIAO DIỆN
    // =====================================================
    var vaiTro = Session["VaiTro"] as string;

    // Chỉ Admin là tài khoản quản lý
    bool laQuanLy = vaiTro == "Admin";

    // Nhân viên và Khách hàng chỉ được đặt dịch vụ
    bool duocDatDichVu =
        vaiTro == "NhanVien" ||
        vaiTro == "KhachHang";

    bool laKhachHang = vaiTro == "KhachHang";
    bool laNhanVien = vaiTro == "NhanVien";

    // Danh sách đơn đặt sân do Controller truyền sang
    var dsDatSan =
        ViewBag.DsDatSan as
        IEnumerable<Phân_Tích_Thiết_Kế_Website_QL_Sân_Bóng.Models.DatSan>;

    bool coDonDatSan =
        dsDatSan != null &&
        dsDatSan.Any();

    ViewBag.Title = laQuanLy
        ? "Quản Lý Dịch Vụ"
        : laNhanVien
            ? "Đặt Dịch Vụ Cho Khách"
            : "Đặt Dịch Vụ";

    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container-fluid" style="padding:20px;">


    <!-- =====================================================
         TIÊU ĐỀ
         ===================================================== -->

    @if (laQuanLy)
    {
        <h2 style="
            font-weight:bold;
            margin-bottom:20px;
            color:#17463a;">

            🥤 QUẢN LÝ DỊCH VỤ

        </h2>
    }
    else
    {
        <h2 style="
            font-weight:bold;
            margin-bottom:20px;
            color:#17463a;">

            @(laNhanVien
                ? "🛒 ĐẶT DỊCH VỤ CHO KHÁCH"
                : "🛒 CHỌN & ĐẶT DỊCH VỤ")

        </h2>
    }



    <!-- =====================================================
         THÔNG BÁO
         ===================================================== -->

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible"
             role="alert">

            <button type="button"
                    class="close"
                    data-dismiss="alert">

                <span>&times;</span>

            </button>

            <strong>Thành công!</strong>
            @TempData["Success"]

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible"
             role="alert">

            <button type="button"
                    class="close"
                    data-dismiss="alert">

                <span>&times;</span>

            </button>

            <strong>Lỗi!</strong>
            @TempData["Error"]

        </div>
    }



    <!-- =====================================================
         TÌM KIẾM + THÊM DỊCH VỤ
         ===================================================== -->

    <div class="row" style="margin-bottom:20px;">


        <!-- TÌM KIẾM -->

        <div class="@(laQuanLy ? "col-md-8" : "col-md-12")">

            <form method="get"
                  action="@Url.Action("Index", "DichVu")"
                  class="form-inline">

                <input type="text"
                       name="tuKhoa"
                       value="@ViewBag.TuKhoa"
                       class="form-control"
                       placeholder="Nhập tên dịch vụ cần tìm..."
                       style="
                           width:350px;
                           max-width:100%;
                           display:inline-block;" />

                <button type="submit"
                        class="btn btn-primary"
                        style="margin-left:5px;">

                    🔍 Tìm kiếm

                </button>


                @if (!string.IsNullOrWhiteSpace(
                    Convert.ToString(ViewBag.TuKhoa)))
                {
                    <a href="@Url.Action("Index", "DichVu")"
                       class="btn btn-default"
                       style="margin-left:5px;">

                        Làm mới

                    </a>
                }

            </form>

        </div>



        <!-- =================================================
             CHỈ ADMIN ĐƯỢC THÊM DỊCH VỤ
             ================================================= -->

        @if (laQuanLy)
        {
            <div class="col-md-4 text-right">

                <button type="button"
                        class="btn btn-success"
                        data-toggle="modal"
                        data-target="#modalThemDichVu">

                    ➕ Thêm Dịch Vụ Mới

                </button>

            </div>
        }

    </div>



    <!-- =====================================================
         THÔNG BÁO CHO NHÂN VIÊN / KHÁCH HÀNG
         ===================================================== -->

    @if (duocDatDichVu)
    {
        if (coDonDatSan)
        {
            <div class="alert alert-info">

                <i class="fa-solid fa-circle-info"></i>

                @if (laNhanVien)
                {
                    <span>
                        Chọn dịch vụ, chọn <strong>đơn đã thanh toán</strong> của khách,
                        nhập số lượng và thu tiền phần dịch vụ phát sinh bằng
                        <strong>Tiền mặt</strong> hoặc <strong>Chuyển khoản</strong>.
                    </span>
                }
                else
                {
                    <span>
                        Chọn dịch vụ bên dưới, sau đó nhấn
                        <strong>Đặt Dịch Vụ</strong>
                        để thêm dịch vụ vào đơn đặt sân.
                    </span>
                }

            </div>
        }
        else
        {
            <div class="alert alert-warning">

                <i class="fa-solid fa-triangle-exclamation"></i>

                @if (laKhachHang)
                {
                    <span>
                        Bạn hiện chưa có đơn đặt sân đang hoạt động.
                        Hãy đặt sân trước khi đặt thêm dịch vụ.
                    </span>
                }
                else
                {
                    <span>
                        Hiện không có đơn đặt sân đang hoạt động
                        để thêm dịch vụ.
                    </span>
                }

            </div>
        }
    }



    <!-- =====================================================
         DANH SÁCH DỊCH VỤ
         ===================================================== -->

    <div class="panel panel-default"
         style="
             border-radius:8px;
             overflow:hidden;
             box-shadow:0 2px 8px rgba(0,0,0,0.06);">


        <div class="panel-heading"
             style="
                 background:#ff9966;
                 color:white;
                 font-weight:bold;">

            @if (laQuanLy)
            {
                <span>
                    Danh sách hàng hóa & dịch vụ
                </span>
            }
            else
            {
                <span>
                    Danh sách dịch vụ có thể đặt
                </span>
            }

        </div>



        <div class="table-responsive">

            <table class="table table-striped table-bordered table-hover"
                   style="margin-bottom:0;">

                <thead>

                    <tr style="background:#f5f5f5;">

                        <th style="width:80px;">
                            Mã DV
                        </th>

                        <th>
                            Tên Dịch Vụ / Tên Món
                        </th>

                        <th style="width:160px;">
                            Đơn Giá (VNĐ)
                        </th>

                        <th style="
                            width:130px;
                            text-align:center;">

                            Số Lượng Tồn

                        </th>


                        @if (laQuanLy)
                        {
                            <th style="
                                width:300px;
                                text-align:center;">

                                Quản Lý

                            </th>
                        }
                        @if (duocDatDichVu && !laQuanLy)
                        {
                            <th style="
                                width:180px;
                                text-align:center;">

                                Đặt Dịch Vụ

                            </th>
                        }

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>


                                <!-- MÃ -->

                                <td>
                                    #@item.MaDichVu
                                </td>



                                <!-- TÊN -->

                                <td style="font-weight:600;">

                                    @item.TenDichVu

                                </td>



                                <!-- GIÁ -->

                                <td>

                                    <strong style="color:#d97925;">

                                        @string.Format(
                                                 "{0:N0}",
                                                 item.DonGia
                                             )

                                    </strong>

                                </td>



                                <!-- TỒN KHO -->

                                <td style="text-align:center;">

                                    <span class="badge"
                                          style="
                                              padding:6px 10px;
                                              color:white;
                                              background-color:
                                              @(item.SoLuongTon <= 0
                                                ? "#777"
                                                : item.SoLuongTon < 10
                                                    ? "#d9534f"
                                                    : "#5cb85c");">

                                        @item.SoLuongTon

                                    </span>

                                </td>



                                <!-- =================================================
                                     ADMIN: QUẢN LÝ DỊCH VỤ
                                     ================================================= -->

                                @if (laQuanLy)
                                {
                                    <td style="text-align:center;">


                                        <!-- NHẬP KHO -->

                                        <button type="button"
                                                class="btn btn-warning btn-xs btn-nhap-kho"
                                                data-ma="@item.MaDichVu"
                                                data-ten="@item.TenDichVu"
                                                data-gia="@item.DonGia">

                                            📦 Nhập Kho

                                        </button>


                                        <!-- SỬA -->

                                        <a href="@Url.Action(
                                                     "Sua",
                                                     "DichVu",
                                                     new
                                                     {
                                                         id = item.MaDichVu
                                                     })"
                                           class="btn btn-primary btn-xs">

                                            ✏️ Sửa

                                        </a>


                                        <!-- XÓA -->

                                        @using (
                                            Html.BeginForm(
                                                "Xoa",
                                                "DichVu",
                                                new
                                                {
                                                    id = item.MaDichVu
                                                },
                                                FormMethod.Post,
                                                new
                                                {
                                                    style = "display:inline;"
                                                }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-danger btn-xs"
                                                    onclick="return confirm('Bạn có chắc chắn muốn xóa dịch vụ này không?');">

                                                🗑️ Xóa

                                            </button>
                                        }

                                    </td>
                                }



                                <!-- =================================================
                                     NHÂN VIÊN / KHÁCH HÀNG:
                                     CHỈ ĐẶT DỊCH VỤ
                                     ================================================= -->
                                @if (duocDatDichVu && !laQuanLy)
                                {
                                    <td style="text-align:center;">

                                        @if (item.SoLuongTon > 0 &&
                                             coDonDatSan)
                                        {
                                            <button type="button"
                                                    class="btn btn-success btn-sm btn-dat-dich-vu"
                                                    data-ma="@item.MaDichVu"
                                                    data-ten="@item.TenDichVu"
                                                    data-gia="@item.DonGia">

                                                🛒 Đặt Dịch Vụ

                                            </button>
                                        }
                                        else if (item.SoLuongTon <= 0)
                                        {
                                            <button type="button"
                                                    class="btn btn-default btn-sm"
                                                    disabled>

                                                Hết hàng

                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-default btn-sm"
                                                    disabled>

                                                Chưa có đơn sân

                                            </button>
                                        }

                                    </td>
                                }

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="5"
                                class="text-center"
                                style="
                                    padding:30px;
                                    color:#777;">

                                Không có dịch vụ nào trong hệ thống.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>



<!-- =========================================================
     CHỈ ADMIN: MODAL QUẢN LÝ
     ========================================================= -->

@if (laQuanLy)
{

    <!-- =====================================================
         MODAL THÊM DỊCH VỤ
         ===================================================== -->

    <div class="modal fade"
         id="modalThemDichVu"
         tabindex="-1"
         role="dialog">

        <div class="modal-dialog"
             role="document">

            <div class="modal-content">


                <form method="post"
                      action="@Url.Action("ThemMoi", "DichVu")">

                    @Html.AntiForgeryToken()


                    <div class="modal-header"
                         style="
                             background:#ff9966;
                             color:white;">

                        <button type="button"
                                class="close"
                                data-dismiss="modal">

                            &times;

                        </button>

                        <h4 class="modal-title"
                            style="font-weight:bold;">

                            ➕ Thêm Dịch Vụ Mới

                        </h4>

                    </div>



                    <div class="modal-body">


                        <div class="form-group">

                            <label>
                                Tên dịch vụ / Món
                            </label>

                            <input type="text"
                                   name="tenDichVu"
                                   class="form-control"
                                   required
                                   placeholder="Ví dụ: Nước suối, Nước ngọt..." />

                        </div>



                        <div class="form-group">

                            <label>
                                Đơn giá (VNĐ)
                            </label>

                            <input type="number"
                                   name="donGia"
                                   class="form-control"
                                   min="0"
                                   required
                                   value="10000" />

                        </div>



                        <div class="form-group">

                            <label>
                                Số lượng tồn ban đầu
                            </label>

                            <input type="number"
                                   name="soLuongTon"
                                   class="form-control"
                                   min="0"
                                   required
                                   value="50" />

                        </div>

                    </div>



                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-default"
                                data-dismiss="modal">

                            Hủy

                        </button>

                        <button type="submit"
                                class="btn btn-success">

                            💾 Lưu Dịch Vụ

                        </button>

                    </div>


                </form>

            </div>

        </div>

    </div>



    <!-- =====================================================
         MODAL NHẬP KHO
         ===================================================== -->

    <div class="modal fade"
         id="modalNhapKho"
         tabindex="-1"
         role="dialog">

        <div class="modal-dialog"
             role="document">

            <div class="modal-content">


                <form method="post"
                      action="@Url.Action("CapNhatKho", "DichVu")">

                    @Html.AntiForgeryToken()


                    <div class="modal-header"
                         style="
                             background:#f0ad4e;
                             color:white;">

                        <button type="button"
                                class="close"
                                data-dismiss="modal">

                            &times;

                        </button>

                        <h4 class="modal-title"
                            id="titleNhapKho"
                            style="font-weight:bold;">

                            📦 Nhập Kho

                        </h4>

                    </div>


                    <div class="modal-body">


                        <input type="hidden"
                               name="maDichVu"
                               id="nhapMaDichVu" />


                        <div class="form-group">

                            <label>
                                Số lượng nhập thêm
                            </label>

                            <input type="number"
                                   name="soLuongThem"
                                   class="form-control"
                                   value="10"
                                   min="1"
                                   required />

                        </div>

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-default"
                                data-dismiss="modal">

                            Hủy

                        </button>

                        <button type="submit"
                                class="btn btn-warning"
                                style="color:white;">

                            Xác Nhận Nhập Kho

                        </button>

                    </div>


                </form>

            </div>

        </div>

    </div>
}



<!-- =========================================================
     NHÂN VIÊN + KHÁCH HÀNG:
     MODAL ĐẶT DỊCH VỤ
     ========================================================= -->

@if (duocDatDichVu)
{
    <div class="modal fade"
         id="modalDatDichVu"
         tabindex="-1"
         role="dialog">

        <div class="modal-dialog"
             role="document">

            <div class="modal-content">


                <form method="post"
                      action="@Url.Action("DatDichVu", "DichVu")">

                    @Html.AntiForgeryToken()


                    <div class="modal-header"
                         style="
                             background:#28a745;
                             color:white;">

                        <button type="button"
                                class="close"
                                data-dismiss="modal">

                            &times;

                        </button>

                        <h4 class="modal-title"
                            id="titleDatDichVu"
                            style="font-weight:bold;">

                            🛒 Đặt Dịch Vụ

                        </h4>

                    </div>



                    <div class="modal-body">


                        <!-- MÃ DỊCH VỤ -->

                        <input type="hidden"
                               name="maDichVu"
                               id="datMaDichVu" />



                        <!-- TÊN DỊCH VỤ -->

                        <div class="form-group">

                            <label>
                                Dịch vụ đã chọn
                            </label>

                            <input type="text"
                                   id="datTenDichVu"
                                   class="form-control"
                                   readonly />

                        </div>



                        <!-- ĐƠN ĐẶT SÂN -->

                        <div class="form-group">

                            @if (laKhachHang)
                            {
                                <label>
                                    Chọn đơn đặt sân của bạn
                                </label>
                            }
                            else
                            {
                                <label>
                                    Chọn đơn đặt sân
                                </label>
                            }


                            <select name="maDatSan"
                                    class="form-control"
                                    required>

                                <option value="">
                                    -- Chọn đơn đặt sân --
                                </option>


                                @if (coDonDatSan)
                                {
                                    foreach (var ds in dsDatSan)
                                    {
                                        string tenKhach =
                                            ds.NguoiDung != null
                                                ? ds.NguoiDung.HoTen
                                                : (!String.IsNullOrWhiteSpace(ds.HoTenKhachHang)
                                                    ? ds.HoTenKhachHang
                                                    : "Không rõ tên");

                                        string soDienThoai =
                                            ds.NguoiDung != null
                                                ? ds.NguoiDung.SoDienThoai
                                                : ds.SoDienThoaiKhachHang;

                                        <option value="@ds.MaDatSan">
                                            Đơn #@ds.MaDatSan
                                            - @(ds.SanBong != null
                                                ? ds.SanBong.TenSan
                                                : "Sân #" + ds.MaSan)
                                            @if (!laKhachHang)
                                            {
                                                <text>
                                                    - @tenKhach
                                                    @if (!String.IsNullOrWhiteSpace(soDienThoai))
                                                    {
                                                        <text> (@soDienThoai)</text>
                                                    }
                                                </text>
                                            }
                                        </option>
                                    }
                                }
                                else
                                {
                                    <option value=""
                                            disabled>

                                        Không có đơn đặt sân đang hoạt động

                                    </option>
                                }

                            </select>

                        </div>



                        <!-- SỐ LƯỢNG -->

                        <div class="form-group">

                            <label>
                                Số lượng
                            </label>

                            <input type="number"
                                   id="datSoLuong"
                                   name="soLuong"
                                   class="form-control"
                                   value="1"
                                   min="1"
                                   required />

                        </div>


                        @if (laNhanVien)
                        {
                            <div class="form-group">
                                <label>
                                    Thanh toán phần dịch vụ phát sinh *
                                </label>

                                <div style="
                                    border:1px solid #d9e3de;
                                    border-radius:8px;
                                    padding:12px 14px;
                                    background:#f8fbf9;">

                                    <label style="
                                        display:block;
                                        cursor:pointer;
                                        margin-bottom:10px;">

                                        <input type="radio"
                                               name="hinhThucThanhToanDichVu"
                                               value="Tiền mặt"
                                               required />

                                        <strong style="margin-left:5px;">
                                            Tiền mặt
                                        </strong>
                                    </label>

                                    <label style="
                                        display:block;
                                        cursor:pointer;
                                        margin-bottom:0;">

                                        <input type="radio"
                                               name="hinhThucThanhToanDichVu"
                                               value="Chuyển khoản"
                                               required />

                                        <strong style="margin-left:5px;">
                                            Chuyển khoản
                                        </strong>
                                    </label>
                                </div>
                            </div>

                            <div class="alert alert-success"
                                 style="padding:10px 12px; margin-bottom:0;">
                                Tiền dịch vụ phát sinh:
                                <strong id="datTienDichVu">0 VNĐ</strong>
                            </div>
                        }

                    </div>



                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-default"
                                data-dismiss="modal">

                            Hủy

                        </button>


                        @if (coDonDatSan)
                        {
                            <button type="submit"
                                    class="btn btn-success">

                                @(laNhanVien
                                    ? "✅ THÊM DỊCH VỤ & XÁC NHẬN ĐÃ THU TIỀN"
                                    : "✅ Xác Nhận Đặt Dịch Vụ")

                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-default"
                                    disabled>

                                Chưa Có Đơn Đặt Sân

                            </button>
                        }

                    </div>


                </form>

            </div>

        </div>

    </div>
}



<!-- =========================================================
     JAVASCRIPT
     ========================================================= -->

@section Scripts
{
    <script>

        $(document).ready(function () {


            // ================================================
            // NHÂN VIÊN / KHÁCH HÀNG - ĐẶT DỊCH VỤ
            // ================================================

            $('.btn-dat-dich-vu').click(function () {

                var maDichVu = $(this).data('ma');
                var tenDichVu = $(this).attr('data-ten');
                var donGia = parseFloat($(this).data('gia')) || 0;

                $('#datMaDichVu').val(maDichVu);
                $('#datTenDichVu').val(tenDichVu);
                $('#datSoLuong').val(1);
                $('#datSoLuong').data('gia', donGia);

                $("input[name='hinhThucThanhToanDichVu']")
                    .prop('checked', false);

                function capNhatTienDichVu() {
                    var soLuong =
                        parseInt($('#datSoLuong').val()) || 0;

                    var thanhTien =
                        donGia * soLuong;

                    $('#datTienDichVu').text(
                        thanhTien.toLocaleString('vi-VN') +
                        ' VNĐ'
                    );
                }

                capNhatTienDichVu();

                $('#datSoLuong')
                    .off('input.dichvu change.dichvu')
                    .on(
                        'input.dichvu change.dichvu',
                        capNhatTienDichVu
                    );

                $('#titleDatDichVu').text(
                    '🛒 ĐẶT DỊCH VỤ: ' +
                    tenDichVu.toUpperCase()
                );

                $('#modalDatDichVu').modal('show');
            });



            // ================================================
            // ADMIN - NHẬP KHO
            // ================================================

            $('.btn-nhap-kho').click(function () {

                var maDichVu = $(this).data('ma');
                var tenDichVu = $(this).attr('data-ten');

                $('#nhapMaDichVu').val(maDichVu);

                $('#titleNhapKho').text(
                    '📦 NHẬP KHO: ' +
                    tenDichVu.toUpperCase()
                );

                $('#modalNhapKho').modal('show');
            });


        });

    </script>
}