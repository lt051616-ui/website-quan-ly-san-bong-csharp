@model Phân_Tích_Thiết_Kế_Website_QL_Sân_Bóng.Models.NguoiDung

@{
    ViewBag.Title = "Sửa Khách Hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid" style="max-width:800px;">

    <h2 style="font-weight:bold; margin-bottom:30px;">
        ✏️ SỬA THÔNG TIN KHÁCH HÀNG
    </h2>

    @* Hiển thị thông báo lỗi nếu có dữ liệu không hợp lệ *@
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible" role="alert" style="margin-bottom: 20px;">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
            <strong>Lỗi!</strong> @TempData["Error"]
        </div>
    }

    <div class="panel panel-default">

        <div class="panel-heading"
             style="background:#ff9966; font-weight:bold;">
            Cập nhật thông tin
        </div>

        <div class="panel-body">

            <form method="post" action="@Url.Action("Sua", "KhachHang", new { id = Model.MaNguoiDung })">

                <!-- Token bảo mật chống lỗi AntiForgery -->
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.MaNguoiDung)

                <div class="form-group">
                    <label>Họ và tên</label>
                    @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control", required = "required" })
                </div>

                <div class="form-group">
                    <label>Số điện thoại</label>
                    @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "form-control", required = "required" })
                </div>

                <div class="form-group">
                    <label>Email</label>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
                </div>

                <div class="form-group">
                    <label>Trạng thái</label>
                    <select name="TrangThai" class="form-control">
                        <option value="Hoạt động" @(Model.TrangThai == "Hoạt động" ? "selected" : "")>
                            Hoạt động
                        </option>
                        <option value="Đã khóa" @(Model.TrangThai == "Đã khóa" ? "selected" : "")>
                            Đã khóa
                        </option>
                    </select>
                </div>

                <hr />

                <button type="submit" class="btn btn-success">
                    💾 Lưu thay đổi
                </button>

                <a href="@Url.Action("Index","KhachHang")" class="btn btn-default">
                    Hủy
                </a>

            </form>

        </div>

    </div>

</div>