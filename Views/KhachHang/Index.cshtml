    @model IEnumerable<Phân_Tích_Thiết_Kế_Website_QL_Sân_Bóng.Models.NguoiDung>

    @{
        ViewBag.Title = "Quản Lý Khách Hàng";
        Layout = "~/Views/Shared/_Layout.cshtml";
    }

    <div class="container-fluid" style="width: 100%; max-width: 1250px;">

        <!-- ================= TIÊU ĐỀ ================= -->

        <div style="
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;">

            <div>
                <h2 style="
                    font-weight: bold;
                    color: #333;
                    margin: 0;">

                    👤 QUẢN LÝ KHÁCH HÀNG
                </h2>

                <p class="text-muted" style="margin-top: 8px;">
                    Tổng số khách hàng đang hiển thị:
                    <strong class="text-primary">
                        @(Model != null ? Model.Count() : 0)
                    </strong>
                </p>
            </div>


            <!-- NÚT THÊM -->

            <button type="button"
                    class="btn btn-success"
                    data-toggle="modal"
                    data-target="#modalThemKhach">

                <i class="glyphicon glyphicon-plus"></i>
                Thêm Khách Hàng Mới

            </button>

        </div>


        <!-- ================= THÔNG BÁO ================= -->

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible">

                <button type="button"
                        class="close"
                        data-dismiss="alert">

                    &times;

                </button>

                <i class="glyphicon glyphicon-ok-circle"></i>

                <strong>Thành công!</strong>

                @TempData["Success"]

            </div>
        }


        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible">

                <button type="button"
                        class="close"
                        data-dismiss="alert">

                    &times;

                </button>

                <i class="glyphicon glyphicon-exclamation-sign"></i>

                <strong>Lỗi!</strong>

                @TempData["Error"]

            </div>
        }


        <!-- ================= TÌM KIẾM ================= -->

        <div class="well"
             style="
                background-color: #fff;
                padding: 20px;
                border-radius: 6px;">

            <form method="get"
                  action="@Url.Action("Index", "KhachHang")">

                <div class="row">

                    <!-- TÌM KIẾM -->

                    <div class="col-md-7">

                        <div class="form-group"
                             style="width: 100%;">

                            <label>
                                🔍 Tìm kiếm khách hàng
                            </label>

                            <input type="text"
                                   name="tuKhoa"
                                   value="@ViewBag.TuKhoa"
                                   class="form-control"
                                   placeholder="Nhập họ tên, số điện thoại hoặc email..." />

                        </div>

                    </div>


                    <!-- LỌC TRẠNG THÁI -->

                    <div class="col-md-3">

                        <div class="form-group"
                             style="width: 100%;">

                            <label>
                                Trạng thái
                            </label>

                            <select name="trangThai"
                                    class="form-control">

                                <option value="">
                                    -- Tất cả trạng thái --
                                </option>

                                @if (ViewBag.TrangThai == "Hoạt động")
                                {
                                    <option value="Hoạt động" selected>
                                        Hoạt động
                                    </option>
                                }
                                else
                                {
                                    <option value="Hoạt động">
                                        Hoạt động
                                    </option>
                                }


                                @if (ViewBag.TrangThai == "Đã khóa")
                                {
                                    <option value="Đã khóa" selected>
                                        Đã khóa
                                    </option>
                                }
                                else
                                {
                                    <option value="Đã khóa">
                                        Đã khóa
                                    </option>
                                }

                            </select>

                        </div>

                    </div>


                    <!-- NÚT -->

                    <div class="col-md-2"
                         style="padding-top: 25px;">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="glyphicon glyphicon-search"></i>

                            Tìm

                        </button>


                        <a href="@Url.Action("Index", "KhachHang")"
                           class="btn btn-default"
                           title="Làm mới">

                            <i class="glyphicon glyphicon-refresh"></i>

                        </a>

                    </div>

                </div>

            </form>

        </div>


        <!-- ================= BẢNG KHÁCH HÀNG ================= -->

        <div class="panel panel-default">

            <div class="panel-body"
                 style="
                    padding: 0;
                    overflow-x: auto;">

                <table class="table table-striped table-bordered table-hover"
                       style="margin-bottom: 0;">

                    <thead>

                        <tr style="
                            background-color: #ff9966;
                            color: #000;">

                            <th class="text-center">
                                Mã KH
                            </th>

                            <th>
                                Họ và Tên
                            </th>

                            <th>
                                Số Điện Thoại
                            </th>

                            <th>
                                Email
                            </th>

                            <th class="text-center">
                                Ngày Tạo
                            </th>

                            <th class="text-center">
                                Trạng Thái
                            </th>

                            <th class="text-center"
                                style="min-width: 210px;">

                                Thao Tác

                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <!-- MÃ KH -->

                                    <td class="text-center">

                                        <strong>
                                            #@item.MaNguoiDung
                                        </strong>

                                    </td>


                                    <!-- HỌ TÊN -->

                                    <td>

                                        <strong>
                                            @item.HoTen
                                        </strong>

                                    </td>


                                    <!-- SĐT -->

                                    <td>

                                        @item.SoDienThoai

                                    </td>


                                    <!-- EMAIL -->

                                    <td>

                                        @if (string.IsNullOrEmpty(item.Email))
                                        {
                                            <span class="text-muted">

                                                Chưa cập nhật

                                            </span>
                                        }
                                        else
                                        {
                                            @item.Email
                                        }

                                    </td>


                                    <!-- NGÀY TẠO -->

                                    <td class="text-center">

                                        @if (item.NgayTao.HasValue)
                                        {
                                            @item.NgayTao.Value.ToString("dd/MM/yyyy")
                                        }

                                    </td>


                                    <!-- TRẠNG THÁI -->

                                    <td class="text-center">

                                        @if (item.TrangThai == "Hoạt động")
                                        {
                                            <span class="label label-success"
                                                  style="font-size: 13px;">

                                                ✓ Hoạt động

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="label label-danger"
                                                  style="font-size: 13px;">

                                                🔒 Đã khóa

                                            </span>
                                        }

                                    </td>


                                    <!-- THAO TÁC -->

                                    <td class="text-center">


                                        <!-- CHI TIẾT -->

                                        <a href="@Url.Action(
                                            "ChiTiet",
                                            "KhachHang",
                                            new { id = item.MaNguoiDung })"
                                           class="btn btn-info btn-xs"
                                           title="Xem chi tiết">

                                            <i class="glyphicon glyphicon-eye-open"></i>

                                            Chi tiết

                                        </a>


                                        <!-- SỬA -->

                                        <a href="@Url.Action(
                                            "Sua",
                                            "KhachHang",
                                            new { id = item.MaNguoiDung })"
                                           class="btn btn-primary btn-xs"
                                           title="Chỉnh sửa">

                                            <i class="glyphicon glyphicon-pencil"></i>

                                            Sửa

                                        </a>


                                        <!-- KHÓA / MỞ KHÓA -->

                                        <form action="@Url.Action(
                                                    "DoiTrangThai",
                                                    "KhachHang",
                                                    new { id = item.MaNguoiDung })"
                                              method="post"
                                              style="display: inline;">

                                            @Html.AntiForgeryToken()


                                            @if (item.TrangThai == "Hoạt động")
                                            {
                                                <button type="submit"
                                                        class="btn btn-warning btn-xs"
                                                        onclick="return confirm('Bạn có chắc muốn khóa khách hàng này không?');">

                                                    <i class="glyphicon glyphicon-lock"></i>

                                                    Khóa

                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-success btn-xs"
                                                        onclick="return confirm('Bạn có chắc muốn mở khóa khách hàng này không?');">

                                                    <i class="glyphicon glyphicon-ok"></i>

                                                    Mở khóa

                                                </button>
                                            }

                                        </form>


                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center"
                                    style="padding: 30px;">

                                    <i class="glyphicon glyphicon-info-sign"></i>

                                    Không tìm thấy khách hàng nào.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>



    <!-- ================================================= -->
    <!-- MODAL THÊM KHÁCH HÀNG -->
    <!-- ================================================= -->

    <div id="modalThemKhach"
         class="modal fade"
         role="dialog">

        <div class="modal-dialog">

            <div class="modal-content">


                <form action="@Url.Action("ThemMoi", "KhachHang")"
                      method="post">

                    <!-- QUAN TRỌNG: CHỐNG LỖI AntiForgery -->

                    @Html.AntiForgeryToken()


                    <!-- HEADER -->

                    <div class="modal-header"
                         style="
                            background-color: #ff9966;
                            color: #000;">

                        <button type="button"
                                class="close"
                                data-dismiss="modal">

                            &times;

                        </button>


                        <h4 class="modal-title"
                            style="font-weight: bold;">

                            👤 THÊM KHÁCH HÀNG MỚI

                        </h4>

                    </div>


                    <!-- BODY -->

                    <div class="modal-body">


                        <!-- HỌ TÊN -->

                        <div class="form-group">

                            <label>

                                Họ và Tên

                                <span class="text-danger">*</span>

                            </label>


                            <input type="text"
                                   name="hoTen"
                                   class="form-control"
                                   required
                                   maxlength="100"
                                   placeholder="Nhập họ tên khách hàng" />

                        </div>


                        <!-- SĐT -->

                        <div class="form-group">

                            <label>

                                Số Điện Thoại

                                <span class="text-danger">*</span>

                            </label>


                            <input type="text"
                                   name="soDienThoai"
                                   class="form-control"
                                   required
                                   maxlength="15"
                                   placeholder="Ví dụ: 0987654321" />

                        </div>


                        <!-- EMAIL -->

                        <div class="form-group">

                            <label>
                                Email
                            </label>


                            <input type="email"
                                   name="email"
                                   class="form-control"
                                   placeholder="Nhập email nếu có" />

                        </div>


                        <!-- THÔNG BÁO -->

                        <div class="alert alert-info"
                             style="margin-bottom: 0;">

                            <i class="glyphicon glyphicon-info-sign"></i>

                            Tài khoản khách hàng sẽ được tạo với mật khẩu mặc định:

                            <strong>123456</strong>

                        </div>


                    </div>


                    <!-- FOOTER -->

                    <div class="modal-footer">

                        <button type="submit"
                                class="btn btn-success">

                            <i class="glyphicon glyphicon-floppy-disk"></i>

                            Lưu Thông Tin

                        </button>


                        <button type="button"
                                class="btn btn-default"
                                data-dismiss="modal">

                            Hủy

                        </button>

                    </div>


                </form>

            </div>

        </div>

    </div>