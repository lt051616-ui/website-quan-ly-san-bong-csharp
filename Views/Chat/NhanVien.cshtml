@model IEnumerable<Phân_Tích_Thiết_Kế_Website_QL_Sân_Bóng.Controllers.ChatController.CuocTroChuyenNhanVienVM>

@{
    ViewBag.Title = "Tin nhắn khách hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int? maDangChon = ViewBag.MaCuocTroChuyenDangChon as int?;
}

<style>
    .staff-chat-page {
        padding: 25px;
    }

    .staff-chat-shell {
        height: calc(100vh - 150px);
        min-height: 560px;
        background: #fff;
        border: 1px solid #dfe8e3;
        border-radius: 16px;
        overflow: hidden;
        display: grid;
        grid-template-columns: 360px minmax(0, 1fr);
        box-shadow: 0 8px 28px rgba(0,0,0,.08);
    }

    .staff-chat-list {
        min-height: 0;
        border-right: 1px solid #e5ece8;
        overflow-y: auto;
        background: #f8fbf9;
    }

    .staff-chat-list-title {
        padding: 18px;
        background: #087f5b;
        color: #fff;
        font-size: 18px;
        font-weight: 800;
        position: sticky;
        top: 0;
        z-index: 2;
    }

    .conversation-item {
        display: block;
        width: 100%;
        text-align: left;
        border: 0;
        border-bottom: 1px solid #e4ece8;
        background: #fff;
        padding: 15px 16px;
        cursor: pointer;
    }

        .conversation-item:hover,
        .conversation-item.active {
            background: #eaf7f1;
        }

    .conversation-name {
        font-weight: 800;
        color: #163d31;
        display: flex;
        justify-content: space-between;
        gap: 10px;
    }

    .conversation-status {
        margin-top: 5px;
        font-size: 12px;
        color: #168651;
        font-weight: 700;
    }

    .conversation-preview {
        margin-top: 6px;
        color: #6c7d75;
        font-size: 12px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .chat-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 22px;
        height: 22px;
        border-radius: 999px;
        background: #dc3545;
        color: #fff;
        font-size: 11px;
        padding: 0 6px;
    }

    /* QUAN TRỌNG:
       min-height:0 + overflow:hidden giúp vùng tin nhắn cuộn
       thay vì đẩy thanh nhập phản hồi xuống dưới màn hình. */
    .staff-chat-main {
        min-width: 0;
        min-height: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        background: #fff;
    }

    .staff-chat-header {
        flex: 0 0 auto;
        padding: 15px 18px;
        border-bottom: 1px solid #e4ebe7;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #fff;
        z-index: 3;
    }

    .staff-chat-customer {
        font-size: 18px;
        font-weight: 800;
        color: #163d31;
    }

    .staff-chat-actions {
        display: flex;
        gap: 8px;
    }

        .staff-chat-actions button {
            border: 0;
            border-radius: 8px;
            padding: 8px 12px;
            font-weight: 700;
            cursor: pointer;
        }

    .btn-tiep-nhan {
        background: #0fa958;
        color: #fff;
    }

    .btn-dong-cuoc {
        background: #eff2f1;
        color: #384941;
    }

    .staff-messages {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        padding: 18px;
        background: #f8fbf9;
        overscroll-behavior: contain;
    }

    .staff-empty {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: #7c8c84;
    }

    .staff-msg-row {
        display: flex;
        margin-bottom: 11px;
    }

        .staff-msg-row.staff {
            justify-content: flex-end;
        }

    .staff-msg-bubble {
        max-width: 72%;
        padding: 10px 12px;
        border-radius: 14px;
        line-height: 1.5;
        word-break: break-word;
        white-space: pre-wrap;
    }

    .staff-msg-row.staff .staff-msg-bubble {
        background: #0fa958;
        color: #fff;
        border-bottom-right-radius: 4px;
    }

    .staff-msg-row.customer .staff-msg-bubble {
        background: #fff;
        border: 1px solid #dfe8e3;
        color: #263c33;
        border-bottom-left-radius: 4px;
    }

    .staff-msg-row.ai .staff-msg-bubble {
        background: #fff8df;
        border: 1px solid #f4e3a5;
        color: #55491c;
        border-bottom-left-radius: 4px;
    }

    .staff-msg-sender {
        font-size: 10px;
        font-weight: 800;
        opacity: .7;
        margin-bottom: 3px;
    }

    .staff-msg-time {
        font-size: 10px;
        opacity: .65;
        margin-top: 4px;
        text-align: right;
    }

    /* Thanh phản hồi luôn giữ ở đáy khung chat */
    .staff-reply {
        flex: 0 0 auto;
        position: relative;
        z-index: 5;
        padding: 12px;
        border-top: 1px solid #e4ebe7;
        display: flex;
        gap: 9px;
        background: #fff;
        box-shadow: 0 -4px 12px rgba(0,0,0,.03);
    }

        .staff-reply textarea {
            flex: 1;
            min-width: 0;
            height: 50px;
            resize: none;
            border-radius: 10px;
            border: 1px solid #bad9ca;
            padding: 12px;
            outline: none;
            background: #fff;
            color: #263c33;
        }

            .staff-reply textarea:focus {
                border-color: #0fa958;
                box-shadow: 0 0 0 3px rgba(15,169,88,.10);
            }

            .staff-reply textarea:disabled {
                background: #f3f5f4;
                color: #9aa6a0;
                cursor: not-allowed;
            }

        .staff-reply button {
            flex: 0 0 95px;
            width: 95px;
            border: 0;
            border-radius: 10px;
            background: #0fa958;
            color: #fff;
            font-weight: 800;
            cursor: pointer;
        }

            .staff-reply button:disabled {
                background: #a8cdb9;
                cursor: not-allowed;
            }

    @@media (max-width: 900px) {
        .staff-chat-shell {
            grid-template-columns: 290px minmax(0, 1fr);
        }
    }
</style>

<div id="chatNhanVienToken">@Html.AntiForgeryToken()</div>

<div class="staff-chat-page">
    <h3 style="font-weight:800;color:#075c45;margin-top:0;"><i class="fa fa-comments"></i> Tin nhắn khách hàng</h3>

    <div class="staff-chat-shell">
        <div class="staff-chat-list">
            <div class="staff-chat-list-title">Cuộc trò chuyện</div>

            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <button type="button"
                            class="conversation-item @(maDangChon == item.MaCuocTroChuyen ? "active" : "")"
                            data-id="@item.MaCuocTroChuyen">
                        <div class="conversation-name">
                            <span>@item.TenKhachHang</span>
                            @if (item.SoTinChuaDoc > 0)
                            {
                                <span class="chat-badge">@item.SoTinChuaDoc</span>
                            }
                        </div>
                        <div class="conversation-status">@item.TrangThai</div>
                        <div class="conversation-preview">@item.TinNhanCuoi</div>
                    </button>
                }
            }
            else
            {
                <div style="padding:25px;text-align:center;color:#788981;">Chưa có cuộc trò chuyện nào.</div>
            }
        </div>

        <div class="staff-chat-main">
            <div class="staff-chat-header">
                <div>
                    <div id="staffCustomerName" class="staff-chat-customer">Chọn một cuộc trò chuyện</div>
                    <div id="staffConversationStatus" style="font-size:12px;color:#73847c;margin-top:3px;"></div>
                </div>
                <div class="staff-chat-actions">
                    <button type="button" id="btnNhanChat" class="btn-tiep-nhan" style="display:none;">Tiếp nhận</button>
                    <button type="button" id="btnDongChatNhanVien" class="btn-dong-cuoc" style="display:none;">Đóng cuộc chat</button>
                </div>
            </div>

            <div id="staffMessages" class="staff-messages">
                <div class="staff-empty"><div><div style="font-size:44px;margin-bottom:10px;">💬</div>Chọn một khách hàng bên trái để bắt đầu hỗ trợ.</div></div>
            </div>

            <div class="staff-reply">
                <textarea id="txtNhanVienTraLoi" maxlength="2000" placeholder="Nhập phản hồi..." disabled></textarea>
                <button type="button" id="btnNhanVienGui" disabled>Gửi</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
$(document).ready(function(){
    var currentId=null;
    var token=$("#chatNhanVienToken input[name='__RequestVerificationToken']").val();
    function enc(v){return $("<div/>").text(v||"").html();}
    function render(ds){
        var box=$("#staffMessages");box.empty();
        $.each(ds||[],function(i,t){
            var c="customer",s="Khách hàng";
            if(t.loaiNguoiGui==="NhanVien"){c="staff";s="Nhân viên";}
            else if(t.loaiNguoiGui==="AI"){c="ai";s="Trợ lý AI";}
            box.append('<div class="staff-msg-row '+c+'"><div class="staff-msg-bubble"><div class="staff-msg-sender">'+enc(s)+'</div>'+enc(t.noiDung)+'<div class="staff-msg-time">'+enc(t.thoiGianGui)+'</div></div></div>');
        });
        if(box[0])box.scrollTop(box[0].scrollHeight);
    }
    function tai(id){
        if(!id)return;
        $.get('@Url.Action("LayTinNhanNhanVien", "Chat")',{id:id},function(r){
            if(!r||!r.success){alert(r&&r.message?r.message:"Không thể tải cuộc trò chuyện.");return;}
            currentId=id;
            $(".conversation-item").removeClass("active");$('.conversation-item[data-id="'+id+'"]').addClass("active");
            $("#staffCustomerName").text(r.tenKhachHang);$("#staffConversationStatus").text(r.trangThai);render(r.tinNhans);
            var dangChoNhanVien =
                r.trangThai === "Chờ nhân viên";

            $("#btnNhanChat")
                .toggle(dangChoNhanVien);

            $("#btnDongChatNhanVien")
                .show();

            // Đã chọn được một cuộc trò chuyện thì luôn hiện
            // và cho phép nhập phản hồi. Nếu đang chờ, nhân viên
            // có thể bấm "Tiếp nhận" trước hoặc trả lời trực tiếp.
            $("#txtNhanVienTraLoi")
                .prop("disabled", false);

            $("#btnNhanVienGui")
                .prop("disabled", false);
        });
    }
    $(".conversation-item").on("click",function(){tai($(this).data("id"));});
    $("#btnNhanChat").on("click",function(){if(!currentId)return;$.post('@Url.Action("NhanCuocTroChuyen", "Chat")',{__RequestVerificationToken:token,id:currentId},function(r){if(r&&r.success)tai(currentId);else alert(r&&r.message?r.message:"Không thể tiếp nhận.");});});
    function gui(){
        if(!currentId)return;var nd=$.trim($("#txtNhanVienTraLoi").val());if(!nd)return;
        $.post('@Url.Action("NhanVienTraLoi", "Chat")',{__RequestVerificationToken:token,id:currentId,noiDung:nd},function(r){if(r&&r.success){$("#txtNhanVienTraLoi").val("");tai(currentId);}else alert(r&&r.message?r.message:"Không thể gửi phản hồi.");});
    }
    $("#btnNhanVienGui").on("click",gui);$("#txtNhanVienTraLoi").on("keydown",function(e){if(e.keyCode===13&&!e.shiftKey){e.preventDefault();gui();}});
    $("#btnDongChatNhanVien").on("click",function(){if(!currentId||!confirm("Bạn muốn kết thúc cuộc trò chuyện này?"))return;$.post('@Url.Action("DongCuocTroChuyen", "Chat")',{__RequestVerificationToken:token,id:currentId},function(r){if(r&&r.success)location.reload();});});
    var idTuServer='@(maDangChon.HasValue ? maDangChon.Value.ToString() : "")';if(idTuServer)tai(parseInt(idTuServer));
    setInterval(function(){if(currentId)tai(currentId);},4000);
});
    </script>
}
